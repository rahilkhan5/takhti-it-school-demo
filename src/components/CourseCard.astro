---
// One course in the catalogue: cover, title, instructor, rating, length and price.
// The progress line fills in from this browser's progress when the learner is enrolled.
import Cover from './Cover.astro';
import Stars from './Stars.astro';
import { instructors, CATEGORIES } from '../data/courses.js';
import { lessonsOf, priceLabel } from '../lib/learn.js';

interface Props {
  course: any;
  index?: number;
}
const { course: c, index = 0 } = Astro.props;
const teacher = instructors[c.instructor as keyof typeof instructors];
const words = [c.title, c.subtitle, teacher.name, CATEGORIES[c.category as keyof typeof CATEGORIES], ...c.outcomes].join(' ').toLowerCase();
---

<li
  class="card"
  data-course={c.slug}
  data-free={c.price ? '0' : '1'}
  data-level={c.level}
  data-category={c.category}
  data-price={c.price}
  data-rating={c.rating}
  data-learners={c.learners}
  data-order={index}
  data-words={words}
>
  <a class="card-link" href={`/course/${c.slug}/`}>
    <Cover slug={c.slug} class="card-cover" />
    <div class="card-body">
      <h3>{c.title}</h3>
      <p class="card-teacher">{teacher.name}</p>
      <Stars rating={c.rating} ratings={c.ratings} class="card-stars" />
      <p class="card-meta num">
        <span>{c.hours} hours</span>
        <span aria-hidden="true">·</span>
        <span>{lessonsOf(c).length} lessons</span>
        <span aria-hidden="true">·</span>
        <span>{c.level}</span>
      </p>
      <p class="card-price">
        {c.price ? <strong class="num">{priceLabel(c)}</strong> : <span class="tag free">Free</span>}
      </p>
      <div class="card-progress" data-progress hidden>
        <div class="bar"><span /></div>
        <span class="card-progress-text" data-progress-text></span>
      </div>
    </div>
  </a>
</li>

<style>
  .card {
    position: relative;
  }

  .card-link {
    display: grid;
    gap: var(--space-3);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card-link :global(.card-cover) {
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgb(22 24 29 / 0.06);
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }

  @media (hover: hover) {
    .card-link:hover :global(.card-cover) {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }

    .card-link:hover h3 {
      color: var(--brand-deep);
    }
  }

  .card-link:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  .card-body {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .card-body h3 {
    font-family: var(--font);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
    transition: color 160ms ease;
  }

  .card-teacher,
  .card-meta {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
  }

  .card-price {
    margin-top: var(--space-1);
    font-size: var(--step-1);
  }

  .card-progress {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .card-progress-text {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
</style>
