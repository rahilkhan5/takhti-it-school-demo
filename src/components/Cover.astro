---
// Course covers, drawn in code for each course so the catalogue has real
// covers without heavy photos on mobile data. Purely decorative.
interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className } = Astro.props;

// Code shown on the covers, one array of [class, text] tokens per line.
const htmlLines = [
  [['t', '<h1>'], ['', 'Hello, Pakistan'], ['t', '</h1>']],
  [['t', '<p>'], ['', 'My first site'], ['t', '</p>']],
  [['', ' ']],
  [['s', 'h1'], ['', ' {']],
  [['', '  '], ['p', 'color'], ['', ': '], ['v', '#2453d6'], ['', ';']],
  [['', '  '], ['p', 'padding'], ['', ': '], ['v', '16px'], ['', ';']],
  [['', '}']],
];
const pyLines = [
  [['pr', '>>> '], ['', 'print('], ['st', '"Salam"'], ['', ')']],
  [['', 'Salam']],
  [['pr', '>>> '], ['', 'rent, food = '], ['nu', '25000'], ['', ', '], ['nu', '18000']],
  [['pr', '>>> '], ['', 'rent + food']],
  [['nu', '43000']],
  [['pr', '>>> '], ['cur', '']],
];
---

<div class:list={['cover', `cover-${slug}`, className]} aria-hidden="true">
  {
    slug === 'computer-basics' && (
      <div class="win">
        <div class="win-bar">
          <span class="win-title">My CV.docx</span>
          <span class="win-ctrl">
            <i />
            <i />
            <i />
          </span>
        </div>
        <div class="win-body">
          <b class="doc-name">Kamran Ali</b>
          <span class="doc-line w60" />
          <span class="doc-rule" />
          <span class="doc-head">Education</span>
          <span class="doc-line w90" />
          <span class="doc-line w75" />
          <span class="doc-head">Skills</span>
          <span class="doc-line w50" />
        </div>
        <div class="taskbar">
          <i class="start" />
          <i />
          <i />
          <i class="on" />
        </div>
      </div>
    )
  }
  {
    slug === 'excel-office' && (
      <div class="sheet">
        <div class="fx">
          <span class="fx-name">fx</span>
          <code>=SUM(C2:C6)</code>
        </div>
        <table>
          <tr>
            <th />
            <th>A</th>
            <th>B</th>
            <th>C</th>
          </tr>
          <tr>
            <th>1</th>
            <td class="h">Name</td>
            <td class="h">Days</td>
            <td class="h">Salary</td>
          </tr>
          <tr>
            <th>2</th>
            <td>Asad</td>
            <td>26</td>
            <td>42,000</td>
          </tr>
          <tr>
            <th>3</th>
            <td>Nimra</td>
            <td>24</td>
            <td>38,500</td>
          </tr>
          <tr>
            <th>4</th>
            <td>Zubair</td>
            <td>26</td>
            <td>45,000</td>
          </tr>
          <tr>
            <th>5</th>
            <td>Total</td>
            <td />
            <td class="sel">125,500</td>
          </tr>
        </table>
      </div>
    )
  }
  {
    slug === 'html-css' && (
      <div class="editor">
        <pre>
          {htmlLines.map((line) => (
            <span class="ln">{line.map(([c, t]) => (c ? <span class={c}>{t}</span> : t))}</span>
          ))}
        </pre>
        <div class="browser">
          <span class="browser-bar">
            <i />
            <i />
            <i />
          </span>
          <b>Hello, Pakistan</b>
          <span>My first site</span>
        </div>
      </div>
    )
  }
  {
    slug === 'python' && (
      <div class="term">
        <span class="term-bar">
          <i />
          <i />
          <i />
          <em>python</em>
        </span>
        <pre>
          {pyLines.map((line) => (
            <span class="ln">{line.map(([c, t]) => (c ? <span class={c}>{t}</span> : t))}</span>
          ))}
        </pre>
      </div>
    )
  }
  {
    slug === 'graphic-design' && (
      <div class="board">
        <div class="art">
          <span class="art-aa">Aa</span>
          <span class="art-shape" />
          <span class="art-dot" />
        </div>
        <div class="swatches">
          <i style="--c:#e8456b" />
          <i style="--c:#ffb648" />
          <i style="--c:#16181d" />
          <i style="--c:#ffffff" />
        </div>
        <span class="handle h1" />
        <span class="handle h2" />
      </div>
    )
  }
  {
    slug === 'freelancing' && (
      <div class="gig">
        <div class="gig-card">
          <span class="gig-thumb">
            <b>Logo</b>
          </span>
          <span class="gig-title">I will design a modern logo for your business</span>
          <span class="gig-stars">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24">
                <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.8Z" />
              </svg>
            ))}
            <em>5.0</em>
          </span>
          <span class="gig-price">From Rs 8,000</span>
        </div>
        <span class="gig-note">
          <i />
          New order received
        </span>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: inherit;
    font-family: var(--font);
    line-height: 1.25;
    user-select: none;
  }

  i,
  em {
    font-style: normal;
  }

  /* Computer basics: a Word window over a Windows taskbar. */
  .cover-computer-basics {
    background: #dce6fb;
  }

  .win {
    position: absolute;
    inset: 9% 14% 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: #fff;
    border-radius: 2.2cqi 2.2cqi 0 0;
    box-shadow: 0 2cqi 6cqi -2cqi rgb(27 64 173 / 0.35);
  }

  .win-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6cqi 3cqi;
    background: #2b579a;
    color: #fff;
    border-radius: 2.2cqi 2.2cqi 0 0;
    font-size: 3.4cqi;
    font-weight: 600;
  }

  .win-ctrl {
    display: flex;
    gap: 1.8cqi;
  }

  .win-ctrl i {
    width: 2.4cqi;
    height: 2.4cqi;
    border: 0.45cqi solid rgb(255 255 255 / 0.85);
  }

  .win-body {
    display: grid;
    align-content: start;
    gap: 1.5cqi;
    padding: 4cqi 7cqi;
  }

  .doc-name {
    font-family: var(--font-head);
    font-size: 5.4cqi;
    color: #16181d;
  }

  .doc-head {
    margin-top: 1cqi;
    font-size: 3cqi;
    font-weight: 700;
    color: #2b579a;
  }

  .doc-line {
    height: 1.4cqi;
    border-radius: 1cqi;
    background: #d5dae3;
  }

  .doc-rule {
    height: 0.4cqi;
    background: #2b579a;
  }

  .w50 {
    width: 50%;
  }

  .w60 {
    width: 60%;
  }

  .w75 {
    width: 75%;
  }

  .w90 {
    width: 90%;
  }

  .win .taskbar {
    position: absolute;
    left: -16.5%;
    right: -16.5%;
    bottom: 0;
    display: flex;
    justify-content: center;
    gap: 2.4cqi;
    padding: 1.8cqi;
    background: rgb(22 24 29 / 0.9);
  }

  .taskbar i {
    width: 4.2cqi;
    height: 4.2cqi;
    border-radius: 1cqi;
    background: #5f6776;
  }

  .taskbar .start {
    background: #5ea0ff;
  }

  .taskbar .on {
    background: #2b579a;
    box-shadow: 0 1.2cqi 0 -0.6cqi #5ea0ff;
  }

  /* Excel: a salary sheet with the total selected. */
  .cover-excel-office {
    background: #dcefe4;
  }

  .sheet {
    position: absolute;
    inset: 10% 9% -4%;
    background: #fff;
    border-radius: 2cqi 2cqi 0 0;
    box-shadow: 0 2cqi 6cqi -2cqi rgb(11 100 70 / 0.35);
    overflow: hidden;
  }

  .fx {
    display: flex;
    align-items: center;
    gap: 2.4cqi;
    padding: 1.8cqi 3cqi;
    border-bottom: 0.3cqi solid #d5dae3;
    font-size: 3.4cqi;
  }

  .fx-name {
    font-style: italic;
    color: #5f6776;
  }

  .fx code {
    color: #107c41;
    font-weight: 600;
  }

  .sheet table {
    width: 100%;
    border-collapse: collapse;
    font-size: 3.3cqi;
  }

  .sheet th,
  .sheet td {
    padding: 1.2cqi 2cqi;
    border: 0.25cqi solid #e1e5eb;
    text-align: left;
    white-space: nowrap;
  }

  .sheet th {
    width: 6cqi;
    background: #f3f5f7;
    color: #5f6776;
    font-weight: 600;
    text-align: center;
  }

  .sheet td {
    font-variant-numeric: tabular-nums;
  }

  .sheet td.h {
    font-weight: 700;
  }

  .sheet td.sel {
    outline: 0.7cqi solid #107c41;
    outline-offset: -0.35cqi;
    font-weight: 700;
    background: #e8f5ee;
  }

  /* HTML and CSS: code on the left, the page it makes on the right. */
  .cover-html-css {
    background: #1d2230;
  }

  .editor {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 3cqi;
    padding: 0 5cqi;
  }

  .editor pre,
  .term pre {
    margin: 0;
    white-space: normal;
  }

  .editor pre {
    font-family: var(--font-code);
    font-size: 3.5cqi;
    line-height: 1.6;
    color: #d6dbe6;
  }

  .ln {
    display: block;
    white-space: pre;
  }

  .editor .t {
    color: #7fb4ff;
  }

  .editor .s {
    color: #ffcf6e;
  }

  .editor .p {
    color: #8fe3c0;
  }

  .editor .v {
    color: #ff9db5;
  }

  .browser {
    display: grid;
    gap: 1.6cqi;
    padding: 0 3.5cqi 4.5cqi;
    background: #fff;
    border-radius: 2cqi;
    box-shadow: 0 2cqi 6cqi -1cqi rgb(0 0 0 / 0.45);
    transform: rotate(2deg);
  }

  .browser-bar {
    display: flex;
    gap: 1.2cqi;
    margin: 0 -3.5cqi 1.5cqi;
    padding: 1.8cqi 3cqi;
    border-bottom: 0.3cqi solid #e1e5eb;
  }

  .browser-bar i,
  .term-bar i {
    width: 1.8cqi;
    height: 1.8cqi;
    border-radius: 50%;
    background: #c3c9d3;
  }

  .browser b {
    font-family: var(--font-head);
    font-size: 5.2cqi;
    line-height: 1.1;
    color: #2453d6;
  }

  .browser span:last-child {
    font-size: 3.2cqi;
    color: #474e5c;
  }

  /* Python: a terminal doing sums. */
  .cover-python {
    background: #ffe9a8;
  }

  .term {
    position: absolute;
    inset: 11% 10% 0;
    background: #16181d;
    border-radius: 2.2cqi 2.2cqi 0 0;
    box-shadow: 0 2cqi 6cqi -2cqi rgb(122 82 0 / 0.5);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 1.4cqi;
    padding: 2cqi 3cqi;
    border-bottom: 0.3cqi solid #2a2e37;
  }

  .term-bar i {
    background: #474e5c;
  }

  .term-bar em {
    margin-left: auto;
    font-family: var(--font-code);
    font-size: 2.8cqi;
    color: #8b93a3;
  }

  .term pre {
    padding: 3cqi 4.5cqi;
    font-family: var(--font-code);
    font-size: 3.7cqi;
    line-height: 1.6;
    color: #e6e9ef;
  }

  .term .pr {
    color: #ffd23f;
  }

  .term .st {
    color: #8fe3c0;
  }

  .term .nu {
    color: #8fb8ff;
  }

  .term .cur {
    display: inline-block;
    width: 2cqi;
    height: 4cqi;
    vertical-align: -0.6cqi;
    background: #ffd23f;
  }

  /* Graphic design: an artboard with type, shapes and swatches. */
  .cover-graphic-design {
    background: #fbe0e8;
  }

  .board {
    position: absolute;
    inset: 10% 16%;
  }

  .art {
    position: absolute;
    inset: 0;
    background: #fff;
    border-radius: 1.6cqi;
    box-shadow: 0 2cqi 6cqi -2cqi rgb(154 30 70 / 0.35);
    overflow: hidden;
  }

  .art-aa {
    position: absolute;
    left: 8%;
    bottom: 4%;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 21cqi;
    line-height: 1;
    color: #16181d;
  }

  .art-shape {
    position: absolute;
    right: 9%;
    top: 14%;
    width: 21cqi;
    height: 21cqi;
    border-radius: 5cqi;
    background: #e8456b;
    transform: rotate(-10deg);
  }

  .art-dot {
    position: absolute;
    right: 27%;
    bottom: 14%;
    width: 11cqi;
    height: 11cqi;
    border-radius: 50%;
    background: #ffb648;
  }

  .swatches {
    position: absolute;
    left: 50%;
    bottom: -6.5cqi;
    display: flex;
    gap: 1.4cqi;
    padding: 1.4cqi 2cqi;
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 1cqi 3cqi rgb(22 24 29 / 0.18);
    transform: translateX(-50%);
  }

  .swatches i {
    width: 4.2cqi;
    height: 4.2cqi;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 0.3cqi rgb(22 24 29 / 0.15);
  }

  .handle {
    position: absolute;
    width: 2.2cqi;
    height: 2.2cqi;
    border: 0.4cqi solid #2453d6;
    background: #fff;
  }

  .h1 {
    left: -1.1cqi;
    top: -1.1cqi;
  }

  .h2 {
    right: -1.1cqi;
    top: -1.1cqi;
  }

  /* Freelancing: a gig card and a new order. */
  .cover-freelancing {
    background: #e7e2fa;
  }

  .gig {
    position: absolute;
    inset: 0;
  }

  .gig-card {
    position: absolute;
    left: 18%;
    top: 9%;
    width: 46%;
    display: grid;
    gap: 1.4cqi;
    padding: 2.4cqi 2.4cqi 3cqi;
    background: #fff;
    border-radius: 2cqi;
    box-shadow: 0 2cqi 6cqi -2cqi rgb(91 42 151 / 0.4);
  }

  .gig-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 1.2cqi;
    background: #16181d;
  }

  .gig-thumb b {
    font-family: var(--font-head);
    font-size: 6cqi;
    color: #ffb648;
  }

  .gig-title {
    font-size: 2.9cqi;
    font-weight: 600;
    color: #16181d;
  }

  .gig-stars {
    display: flex;
    align-items: center;
    gap: 0.6cqi;
  }

  .gig-stars svg {
    width: 2.4cqi;
    fill: #9a5800;
  }

  .gig-stars em {
    margin-left: 0.8cqi;
    font-size: 2.6cqi;
    font-weight: 700;
    color: #9a5800;
  }

  .gig-price {
    font-size: 3cqi;
    font-weight: 700;
    color: #16181d;
  }

  .gig-note {
    position: absolute;
    right: 9%;
    bottom: 16%;
    display: flex;
    align-items: center;
    gap: 1.6cqi;
    padding: 2cqi 3cqi;
    background: #16181d;
    color: #fff;
    border-radius: 999px;
    font-size: 3.2cqi;
    font-weight: 700;
    box-shadow: 0 2cqi 5cqi -1cqi rgb(22 24 29 / 0.45);
  }

  .gig-note i {
    width: 2.2cqi;
    height: 2.2cqi;
    border-radius: 50%;
    background: #3ddc97;
  }
</style>
