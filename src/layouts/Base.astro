---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { school, courses } from '../data/courses.js';

interface Props {
  title: string;
  description: string;
  current?: 'courses' | 'free' | 'my';
  bare?: boolean;
}
const { title, description, current, bare = false } = Astro.props;
const nav = [
  { key: 'courses', href: '/#courses', label: 'Courses' },
  { key: 'free', href: '/#free', label: 'Free courses' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/source-sans-3-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={{ bare }}>
    <a class="skip" href="#main">Skip to content</a>
    <aside class="demo-strip" aria-label="Demo notice">
      <p>
        <strong>Demo site.</strong>
        <span class="strip-long">{school.full}, its courses, instructors, prices and reviews are made up. Nothing is charged and certificates are examples.</span>
        <span class="strip-short">Made up, nothing is charged.</span>
      </p>
    </aside>

    {
      !bare && (
        <header class="site-header">
          <div class="page header-row">
            <a class="brand" href="/" aria-label={`${school.full}, home`}>
              <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                <path d="M12 6.5a4 4 0 0 1 8 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                <rect x="5" y="6.5" width="22" height="22" rx="5" fill="currentColor" />
                <path d="M10.5 14h11M10.5 18.5h11M10.5 23h6.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
              </svg>
              <span class="brand-name">{school.name}</span>
            </a>
            <nav class="nav" aria-label="Main">
              {nav.map((n) => (
                <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
                  {n.label}
                </a>
              ))}
            </nav>
            <form class="search" action="/" method="get" role="search">
              <label class="visually-hidden" for="site-search">
                Search courses
              </label>
              <Icon name="search" />
              <input id="site-search" name="q" type="search" placeholder="Search for a course" autocomplete="off" />
            </form>
            <a class="my-link" href="/my/" aria-current={current === 'my' ? 'page' : undefined}>
              My learning
              <span class="my-count num" data-my-count hidden>
                0
              </span>
            </a>
          </div>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <footer class="site-footer">
          <div class="page footer-grid">
            <div class="footer-about">
              <a class="brand" href="/">
                <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                  <path d="M12 6.5a4 4 0 0 1 8 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                  <rect x="5" y="6.5" width="22" height="22" rx="5" fill="currentColor" />
                  <path d="M10.5 14h11M10.5 18.5h11M10.5 23h6.5" stroke="#16181d" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                <span class="brand-name">{school.name}</span>
              </a>
              <p>{school.tagline}, from {school.city}. A demo site: the school, courses, instructors and reviews are made up for the demo.</p>
            </div>
            <div>
              <h2 class="footer-title">Courses</h2>
              <ul>
                {courses.map((c) => (
                  <li>
                    <a href={`/course/${c.slug}/`}>{c.title}</a>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h2 class="footer-title">Learning</h2>
              <ul>
                <li>
                  <a href="/my/">My learning</a>
                </li>
                <li>
                  <a href="/#free">Free courses</a>
                </li>
                <li>
                  <a href="/#faq">Questions</a>
                </li>
              </ul>
              <h2 class="footer-title pay-title">Pay with</h2>
              <p class="footer-pay">JazzCash, Easypaisa, debit or credit card. Nothing is charged in this demo.</p>
            </div>
          </div>
        </footer>
      )
    }

    <script>
      import { enrolments } from '../lib/learn.js';
      // The header shows how many courses this browser is enrolled in.
      function paint() {
        const n = Object.keys(enrolments()).length;
        document.querySelectorAll<HTMLElement>('[data-my-count]').forEach((el) => {
          el.textContent = String(n);
          el.hidden = n === 0;
          el.setAttribute('aria-label', `${n} ${n === 1 ? 'course' : 'courses'}`);
        });
      }
      paint();
      window.addEventListener('tk:change', paint);
      window.addEventListener('storage', paint);
    </script>

    <style>
      .skip {
        position: absolute;
        left: var(--space-4);
        top: -100px;
        z-index: 30;
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-s);
        background: var(--ink);
        color: var(--white);
        font-weight: 700;
      }

      .skip:focus {
        top: var(--space-4);
      }

      .demo-strip {
        padding: var(--space-2) var(--space-4);
        background: var(--dark);
        color: var(--on-dark);
        font-size: var(--step--2);
        line-height: 1.45;
        text-align: center;
      }

      .strip-short {
        display: none;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgb(255 255 255 / 0.97);
        border-bottom: 1px solid var(--line);
        box-shadow: 0 2px 8px -6px rgb(22 24 29 / 0.25);
      }

      .header-row {
        display: grid;
        grid-template-columns: auto auto 1fr auto;
        align-items: center;
        gap: var(--space-5);
        min-height: 68px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--ink);
        text-decoration: none;
      }

      .brand:hover {
        color: var(--ink);
      }

      .brand-mark {
        width: 32px;
        color: var(--brand);
      }

      .brand-name {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 1.5rem;
        letter-spacing: -0.01em;
      }

      .nav {
        display: flex;
        gap: var(--space-1);
      }

      .nav a,
      .my-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-height: 44px;
        padding: 0 var(--space-3);
        border-radius: var(--radius-s);
        color: var(--ink);
        font-weight: 600;
        text-decoration: none;
      }

      .nav a:hover,
      .my-link:hover {
        background: var(--surface);
        color: var(--ink);
      }

      .nav a[aria-current],
      .my-link[aria-current] {
        color: var(--brand-deep);
        box-shadow: inset 0 -3px 0 var(--brand);
        border-radius: 0;
      }

      .search {
        position: relative;
        justify-self: stretch;
        max-width: 460px;
      }

      .search :global(.icon) {
        position: absolute;
        left: 14px;
        top: 50%;
        width: 20px;
        color: var(--ink-3);
        transform: translateY(-50%);
        pointer-events: none;
      }

      .search input {
        width: 100%;
        min-height: 44px;
        padding: 0 var(--space-4) 0 44px;
        border: 1.5px solid var(--line-strong);
        border-radius: 999px;
        background: var(--surface);
      }

      .search input:focus-visible {
        border-color: var(--brand);
        background: var(--white);
        outline-offset: 0;
      }

      .my-count {
        display: inline-grid;
        place-items: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        background: var(--brand);
        color: var(--white);
        font-size: var(--step--2);
        font-weight: 700;
      }

      .site-footer {
        margin-top: var(--space-9);
        padding-block: var(--space-7) var(--space-8);
        background: var(--dark);
        color: var(--on-dark-2);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.3fr 1fr 1fr;
        gap: var(--space-7);
      }

      .footer-about {
        display: grid;
        gap: var(--space-3);
        align-content: start;
        max-width: 34ch;
      }

      .footer-about .brand,
      .footer-about .brand:hover {
        color: var(--on-dark);
      }

      .footer-about .brand-mark {
        color: var(--white);
      }

      .footer-title {
        margin-bottom: var(--space-3);
        font-family: var(--font);
        font-size: var(--step-0);
        font-weight: 700;
        color: var(--on-dark);
      }

      .pay-title {
        margin-top: var(--space-5);
      }

      .site-footer ul {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .site-footer a:not(.brand) {
        color: var(--on-dark-2);
        text-decoration: none;
      }

      .site-footer a:not(.brand):hover {
        color: var(--on-dark);
        text-decoration: underline;
      }

      .site-footer :focus-visible {
        outline-color: var(--white);
      }

      .footer-pay {
        max-width: 30ch;
      }

      @media (max-width: 1000px) {
        .header-row {
          grid-template-columns: auto 1fr auto;
        }

        .search {
          display: none;
        }

        .nav {
          justify-content: center;
        }
      }

      @media (max-width: 640px) {
        .strip-long {
          display: none;
        }

        .strip-short {
          display: inline;
        }

        .header-row {
          grid-template-columns: auto auto;
          justify-content: space-between;
          gap: 0 var(--space-3);
          min-height: 0;
          padding-top: var(--space-2);
        }

        .nav {
          grid-column: 1 / -1;
          order: 3;
          justify-content: flex-start;
          margin-inline: calc(var(--space-3) * -1);
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: var(--space-6);
        }
      }
    </style>
  </body>
</html>
