---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { school, courses } from '../../data/courses.js';
import { lessonsOf, priceLabel, PASS_MARK } from '../../lib/learn.js';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}

const { course: c } = Astro.props;
const lessons = lessonsOf(c);
const free = !c.price;
const ids = lessons.map((l) => l.id);
const moduleOf = Object.fromEntries(c.modules.flatMap((m: any, i: number) => m.lessons.map((l: any) => [l.id, i + 1])));
---

<Base title={`Learning: ${c.title} | ${school.full}`} description={`Lessons, notes and the final quiz for ${c.title}. A demo site.`} bare>
  <header class="bar-top">
    <a class="home" href="/" aria-label={`${school.full}, home`}>
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M12 6.5a4 4 0 0 1 8 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <rect x="5" y="6.5" width="22" height="22" rx="5" fill="currentColor" />
        <path d="M10.5 14h11M10.5 18.5h11M10.5 23h6.5" stroke="#16181d" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </a>
    <a class="course-link" href={`/course/${c.slug}/`}>{c.title}</a>
    <div class="top-progress" data-top-progress>
      <span class="num" data-top-text>Not started</span>
      <div class="bar"><span></span></div>
    </div>
    <a class="my" href="/my/">My learning</a>
  </header>

  <div class="player" data-player data-slug={c.slug} data-free={free ? '1' : '0'}>
    <div class="stage-col">
      {
        lessons.map((l: any, i: number) => (
          <article class="lesson" id={l.id} data-panel={l.id} data-preview={l.preview ? '1' : '0'} hidden aria-labelledby={`${l.id}-title`}>
            <div class="stage">
              <div class="stage-video" data-video>
                <span class="stage-course">{c.title}</span>
                <span class="stage-title">{l.title}</span>
                <button class="stage-play" type="button" data-play aria-label={`Play ${l.title}`}>
                  <Icon name="play" />
                </button>
                <span class="stage-len num">{l.mins} min lesson</span>
                <p class="stage-note" data-play-note>
                  Demo: in a real course the lesson video plays here. The notes below are the real lesson.
                </p>
              </div>
              <div class="stage-lock" data-lock>
                <Icon name="lock" />
                <p class="lock-title">{free ? 'Start the course to open this lesson' : 'This lesson is in the full course'}</p>
                <p class="lock-text">{free ? 'It is free. One tap and every lesson opens.' : `Preview lessons are free. Buy the course for ${priceLabel(c)} to open all ${lessons.length}.`}</p>
                {free ? (
                  <button class="button primary" type="button" data-enrol>
                    Start free course
                  </button>
                ) : (
                  <a class="button primary" href={`/checkout/${c.slug}/`}>
                    Buy now, {priceLabel(c)}
                  </a>
                )}
              </div>
            </div>

            <div class="lesson-head">
              <h1 id={`${l.id}-title`}>{l.title}</h1>
              <p class="lesson-count num">
                Lesson {i + 1} of {lessons.length}, section {moduleOf[l.id]}, {l.mins} min
              </p>
              <div class="lesson-actions">
                <button class="button complete" type="button" data-complete={l.id}>
                  <svg class="tick" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  <span data-complete-text>Mark as complete</span>
                </button>
                <div class="nav-lessons">
                  {i > 0 ? (
                    <a class="button" href={`#${ids[i - 1]}`} aria-label="Previous lesson">
                      <Icon name="left" />
                      <span class="nav-word">Previous</span>
                    </a>
                  ) : null}
                  <a class="button next" href={i < ids.length - 1 ? `#${ids[i + 1]}` : '#quiz'} data-next>
                    <span>{i < ids.length - 1 ? 'Next lesson' : 'Final quiz'}</span>
                    <Icon name="right" />
                  </a>
                </div>
              </div>
            </div>

            <div class="notes" data-notes>
              <h2>Lesson notes</h2>
              <p>{l.note}</p>
              <h3>Key points</h3>
              <ul class="points">
                {l.points.map((p: string) => (
                  <li>
                    <Icon name="check" />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }

      <section class="quiz" id="quiz" data-panel="quiz" hidden aria-labelledby="quiz-title">
        <div class="quiz-head">
          <h1 id="quiz-title">Final quiz: check what you learned</h1>
          <p class="quiz-sub">Get at least {PASS_MARK} of {c.quiz.length} right to pass. You can try again as many times as you like.</p>
        </div>
        <div class="stage-lock quiz-lock" data-quiz-lock>
          <Icon name="lock" />
          <p class="lock-title">The quiz opens when you join the course</p>
          {free ? (
            <button class="button primary" type="button" data-enrol>
              Start free course
            </button>
          ) : (
            <a class="button primary" href={`/checkout/${c.slug}/`}>
              Buy now, {priceLabel(c)}
            </a>
          )}
        </div>
        <form class="quiz-form" data-quiz novalidate>
          {
            c.quiz.map((q: any, qi: number) => (
              <fieldset class="question" data-question={qi}>
                <legend>
                  <span class="q-n num">{qi + 1}.</span> {q.q}
                </legend>
                <div class="options">
                  {q.options.map((o: string, oi: number) => (
                    <label class="option">
                      <input type="radio" name={`q${qi}`} value={oi} />
                      <span class="option-dot" aria-hidden="true" />
                      <span>{o}</span>
                    </label>
                  ))}
                </div>
                <p class="why" data-why hidden>
                  <strong data-verdict />
                  <span>{q.why}</span>
                </p>
              </fieldset>
            ))
          }
          <p class="field-error" data-quiz-error hidden></p>
          <div class="quiz-actions">
            <button class="button primary" type="submit" data-quiz-submit>
              Check my answers
            </button>
            <button class="button" type="button" data-quiz-retry hidden>
              Try again
            </button>
          </div>
          <div class="result" data-quiz-result role="status" tabindex="-1" hidden>
            <p class="result-score num" data-score></p>
            <p data-result-text></p>
            <a class="button primary" href={`/certificate/${c.slug}/`} data-result-cert hidden>
              <Icon name="award" />
              Get your certificate
            </a>
          </div>
        </form>
      </section>
    </div>

    <aside class="side" aria-labelledby="side-title">
      <div class="side-head">
        <h2 id="side-title">Course content</h2>
        <p class="num" data-side-text></p>
        <div class="bar"><span></span></div>
      </div>
      <nav aria-labelledby="side-title">
        {
          c.modules.map((m: any, mi: number) => (
            <div class="side-module">
              <p class="side-module-title">
                Section {mi + 1}: {m.title}
              </p>
              <ol>
                {m.lessons.map((l: any) => (
                  <li>
                    <a href={`#${l.id}`} data-side={l.id}>
                      <span class="side-icon" aria-hidden="true">
                        <svg class="side-check" viewBox="0 0 24 24">
                          <path d="M5 12.5l4.5 4.5L19 7.5" />
                        </svg>
                        <Icon name="lock" class="side-lock" />
                      </span>
                      <span class="side-title">{l.title}</span>
                      <span class="side-mins num">{l.mins} min</span>
                      <span class="visually-hidden" data-side-state />
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
        <div class="side-module">
          <p class="side-module-title">Finish</p>
          <ol>
            <li>
              <a href="#quiz" data-side="quiz">
                <span class="side-icon" aria-hidden="true">
                  <svg class="side-check" viewBox="0 0 24 24">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  <Icon name="quiz" class="side-lock side-quiz" />
                </span>
                <span class="side-title">Final quiz</span>
                <span class="side-mins num" data-quiz-best></span>
                <span class="visually-hidden" data-side-state />
              </a>
            </li>
            <li>
              <a href={`/certificate/${c.slug}/`} class="side-cert" data-side-cert aria-disabled="true">
                <span class="side-icon" aria-hidden="true">
                  <Icon name="award" class="side-award" />
                </span>
                <span class="side-title">Certificate</span>
                <span class="side-mins" data-cert-state>Locked</span>
              </a>
            </li>
          </ol>
        </div>
      </nav>
    </aside>
  </div>
</Base>

<script>
  import { courses } from '../../data/courses.js';
  import { enrol, doneIds, lessonsOf, quizResult, saveQuiz, setDone, standing, PASS_MARK } from '../../lib/learn.js';

  const player = document.querySelector<HTMLElement>('[data-player]')!;
  const slug = player.dataset.slug!;
  const course = courses.find((x) => x.slug === slug)!;
  const lessons = lessonsOf(course);
  const ids = lessons.map((l) => l.id);
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const justDone = new Set<string>();

  function defaultPanel() {
    const s = standing(course);
    if (!s.enrolled) return lessons.find((l) => l.preview)!.id;
    return s.next ? s.next.id : 'quiz';
  }

  function currentId() {
    const h = decodeURIComponent(location.hash.slice(1));
    return ids.includes(h) || h === 'quiz' ? h : defaultPanel();
  }

  function render(scroll = false) {
    const s = standing(course);
    const done = new Set(doneIds(slug));
    const id = currentId();

    for (const p of panels) {
      const on = p.dataset.panel === id;
      p.hidden = !on;
      if (p.dataset.panel === 'quiz') continue;
      const locked = !s.enrolled && p.dataset.preview !== '1';
      p.classList.toggle('locked', locked);
      p.querySelector<HTMLElement>('[data-video]')!.hidden = locked;
      p.querySelector<HTMLElement>('[data-lock]')!.hidden = !locked;
      p.querySelector<HTMLElement>('[data-notes]')!.hidden = locked;
      const btn = p.querySelector<HTMLButtonElement>('[data-complete]')!;
      const isDone = done.has(p.dataset.panel!);
      btn.hidden = !s.enrolled;
      btn.classList.toggle('is-done', isDone);
      btn.setAttribute('aria-pressed', String(isDone));
      btn.querySelector('[data-complete-text]')!.textContent = isDone ? 'Completed' : 'Mark as complete';
      p.querySelector('[data-next]')!.classList.toggle('primary', isDone || !s.enrolled);
    }

    // Quiz panel
    const quizPanel = panels.find((p) => p.dataset.panel === 'quiz')!;
    quizPanel.querySelector<HTMLElement>('[data-quiz-lock]')!.hidden = s.enrolled;
    quizPanel.querySelector<HTMLElement>('[data-quiz]')!.hidden = !s.enrolled;

    // Sidebar
    document.querySelectorAll<HTMLAnchorElement>('[data-side]').forEach((a) => {
      const key = a.dataset.side!;
      const lesson = lessons.find((l) => l.id === key);
      const isDone = key === 'quiz' ? Boolean(s.quiz?.passed) : done.has(key);
      const locked = !s.enrolled && (key === 'quiz' || !lesson?.preview);
      a.classList.toggle('is-done', isDone);
      a.classList.toggle('is-locked', locked);
      a.classList.toggle('drawn', justDone.has(key));
      if (key === id) a.setAttribute('aria-current', 'step');
      else a.removeAttribute('aria-current');
      a.querySelector('[data-side-state]')!.textContent = isDone ? ', completed' : locked ? ', locked' : '';
    });
    justDone.clear();
    const best = quizResult(slug);
    document.querySelector('[data-quiz-best]')!.textContent = best ? `Best ${best.score} of ${best.total}` : `${course.quiz.length} questions`;
    const cert = document.querySelector<HTMLAnchorElement>('[data-side-cert]')!;
    cert.setAttribute('aria-disabled', String(!s.certificate));
    cert.classList.toggle('is-ready', s.certificate);
    document.querySelector('[data-cert-state]')!.textContent = s.certificate ? 'Ready' : 'Locked';

    // Progress everywhere on the page
    const text = s.enrolled ? `${s.finished} of ${s.total} lessons done` : 'Preview mode';
    document.querySelector('[data-top-text]')!.textContent = text;
    document.querySelector('[data-side-text]')!.textContent = s.enrolled ? `${s.percent}% complete` : 'Join the course to save progress';
    document.querySelectorAll<HTMLElement>('.top-progress .bar, .side-head .bar').forEach((b) => {
      b.style.setProperty('--p', `${s.enrolled ? s.percent : 0}%`);
      b.classList.toggle('done', s.percent === 100);
    });

    if (scroll) window.scrollTo({ top: 0 });
  }

  cert();
  function cert() {
    document.querySelector<HTMLAnchorElement>('[data-side-cert]')!.addEventListener('click', (e) => {
      if (!standing(course).certificate) e.preventDefault();
    });
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const complete = t.closest<HTMLButtonElement>('[data-complete]');
    if (complete) {
      const id = complete.dataset.complete!;
      const isDone = doneIds(slug).includes(id);
      setDone(slug, id, !isDone);
      if (!isDone) justDone.add(id);
      render();
      return;
    }
    const play = t.closest<HTMLButtonElement>('[data-play]');
    if (play) {
      const note = play.parentElement!.querySelector<HTMLElement>('[data-play-note]')!;
      note.classList.remove('nudge');
      void note.offsetWidth;
      note.classList.add('nudge');
      return;
    }
    if (t.closest('[data-enrol]')) {
      enrol(slug, { paid: false });
      render();
    }
  });

  // Quiz
  const form = document.querySelector<HTMLFormElement>('[data-quiz]')!;
  const error = form.querySelector<HTMLElement>('[data-quiz-error]')!;
  const resultBox = form.querySelector<HTMLElement>('[data-quiz-result]')!;
  const retry = form.querySelector<HTMLButtonElement>('[data-quiz-retry]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-quiz-submit]')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const answers = course.quiz.map((_, i) => form.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`));
    const missing = answers.findIndex((a) => !a);
    if (missing !== -1) {
      error.textContent = `Answer question ${missing + 1} first. ${answers.filter((a) => !a).length} left.`;
      error.hidden = false;
      form.querySelector<HTMLInputElement>(`input[name="q${missing}"]`)!.focus();
      return;
    }
    error.hidden = true;
    let score = 0;
    course.quiz.forEach((q, i) => {
      const right = Number(answers[i]!.value) === q.answer;
      if (right) score += 1;
      const box = form.querySelector<HTMLElement>(`[data-question="${i}"]`)!;
      box.classList.toggle('right', right);
      box.classList.toggle('wrong', !right);
      box.querySelectorAll<HTMLInputElement>('input').forEach((inp) => (inp.disabled = true));
      box.querySelectorAll<HTMLElement>('.option').forEach((o, oi) => o.classList.toggle('is-answer', oi === q.answer));
      const why = box.querySelector<HTMLElement>('[data-why]')!;
      why.hidden = false;
      why.querySelector('[data-verdict]')!.textContent = right ? 'Right. ' : 'Not quite. ';
    });
    const saved = saveQuiz(slug, score, course.quiz.length);
    const s = standing(course);
    resultBox.hidden = false;
    resultBox.classList.toggle('passed', score >= PASS_MARK);
    resultBox.querySelector('[data-score]')!.textContent = `${score} of ${course.quiz.length} right`;
    const left = s.total - s.finished;
    resultBox.querySelector('[data-result-text]')!.textContent =
      score >= PASS_MARK
        ? s.certificate
          ? 'You passed, and every lesson is done. Your certificate is ready.'
          : `You passed. Finish the last ${left} ${left === 1 ? 'lesson' : 'lessons'} to unlock your certificate.`
        : `You need ${PASS_MARK} to pass. Read the notes on the questions you missed and try again.${saved.passed ? ' Your earlier pass still counts.' : ''}`;
    resultBox.querySelector<HTMLElement>('[data-result-cert]')!.hidden = !s.certificate;
    submit.hidden = true;
    retry.hidden = false;
    render();
    resultBox.focus();
  });

  retry.addEventListener('click', () => {
    form.reset();
    form.querySelectorAll<HTMLElement>('[data-question]').forEach((box) => {
      box.classList.remove('right', 'wrong');
      box.querySelectorAll<HTMLInputElement>('input').forEach((inp) => (inp.disabled = false));
      box.querySelectorAll('.option').forEach((o) => o.classList.remove('is-answer'));
      box.querySelector<HTMLElement>('[data-why]')!.hidden = true;
    });
    resultBox.hidden = true;
    submit.hidden = false;
    retry.hidden = true;
    form.querySelector<HTMLInputElement>('input')!.focus();
  });

  window.addEventListener('hashchange', () => render(true));
  window.addEventListener('storage', () => render());
  render();
</script>

<style>
  :global(body.bare) {
    background: var(--white);
  }

  .bar-top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
    padding: 0 var(--space-5);
    background: var(--dark);
    color: var(--on-dark);
  }

  .home {
    display: grid;
    color: var(--white);
  }

  .home svg {
    width: 30px;
  }

  .course-link {
    flex: 1;
    min-width: 0;
    padding-left: var(--space-4);
    border-left: 1px solid var(--dark-2);
    color: var(--on-dark);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .course-link:hover,
  .my:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .top-progress {
    display: grid;
    gap: 4px;
    width: 180px;
    font-size: var(--step--2);
    color: var(--on-dark-2);
  }

  .top-progress .bar {
    height: 6px;
    background: var(--dark-2);
  }

  .my {
    color: var(--on-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .bar-top :focus-visible {
    outline-color: var(--on-dark-link);
  }

  .player {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    align-items: start;
  }

  .stage-col {
    min-width: 0;
  }

  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 68svh;
    width: 100%;
    background: #0d0f13;
    color: var(--white);
  }

  .stage-video,
  .stage > .stage-lock {
    position: absolute;
    inset: 0;
  }

  .stage-video {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: radial-gradient(120% 90% at 30% 20%, var(--stage-glow) 0%, var(--stage-deep) 70%);
    text-align: center;
  }

  .stage-course {
    font-size: var(--step--1);
    color: var(--on-dark-2);
  }

  .stage-title {
    max-width: 22ch;
    font-family: var(--font-head);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.15;
  }

  .stage-play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--stage-shadow);
    transition: transform 200ms var(--ease-out);
  }

  .stage-play :global(.icon) {
    width: 28px;
    margin-left: 4px;
  }

  .stage-play:hover {
    transform: scale(1.06);
  }

  .stage-play:active {
    transform: scale(0.96);
  }

  .stage-play:focus-visible {
    outline-color: var(--on-dark-link);
    outline-offset: 4px;
  }

  .stage-len {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-3);
    padding: 2px var(--space-2);
    border-radius: var(--radius-s);
    background: var(--stage-scrim);
    font-size: var(--step--2);
  }

  .stage-note {
    max-width: 44ch;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-s);
    background: rgb(255 255 255 / 0.12);
    font-size: var(--step--1);
  }

  /* Pressing play points at the demo note instead of pretending to play. */
  .stage-note.nudge {
    animation: nudge 420ms var(--ease-out);
  }

  @keyframes nudge {
    0% {
      background: rgb(255 255 255 / 0.32);
      transform: scale(1.04);
    }
    100% {
      background: rgb(255 255 255 / 0.12);
      transform: none;
    }
  }

  .stage-lock {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-3);
    padding: var(--space-6);
    background: #1b1f27;
    text-align: center;
  }

  .stage-lock > :global(.icon) {
    width: 40px;
    color: var(--on-dark-2);
  }

  .lock-title {
    font-family: var(--font-head);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
  }

  .lock-text {
    max-width: 46ch;
    color: var(--on-dark-2);
  }

  .lesson-head,
  .notes,
  .quiz-head,
  .quiz-form,
  .quiz-lock {
    width: min(820px, 100% - 3rem);
    margin-inline: auto;
  }

  .lesson-head {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .lesson-count {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-3);
  }

  .lesson-head h1,
  .quiz-head h1 {
    font-size: var(--step-3);
  }

  .lesson-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .nav-lessons {
    display: flex;
    gap: var(--space-2);
  }

  .complete {
    border-color: var(--line-strong);
  }

  .complete .tick {
    width: 22px;
    padding: 3px;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    fill: none;
    stroke: transparent;
    stroke-width: 3;
