---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { school, courses, instructors } from '../../data/courses.js';
import { lessonsOf } from '../../lib/learn.js';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}

const { course: c } = Astro.props;
const teacher = instructors[c.instructor as keyof typeof instructors];
---

<Base title={`Certificate: ${c.title} | ${school.full}`} description={`Your example certificate for ${c.title}. A demo site, not a real qualification.`}>
  <div class="page cert-page" data-cert-page data-slug={c.slug}>
    <a class="back" href={`/learn/${c.slug}/`}><Icon name="left" />Back to the course</a>

    <section class="locked" data-locked hidden aria-labelledby="locked-title">
      <Icon name="lock" />
      <h1 id="locked-title">Your certificate is not ready yet</h1>
      <p data-locked-text>Finish every lesson and pass the final quiz to unlock it.</p>
      <div class="bar"><span></span></div>
      <a class="button primary" href={`/learn/${c.slug}/`} data-locked-go>Go to the course</a>
    </section>

    <section class="ready" data-ready hidden aria-labelledby="ready-title">
      <div class="ready-head">
        <h1 id="ready-title">Your certificate</h1>
        <form class="name-form" data-name-form>
          <label class="field">
            <span class="field-label">Name on the certificate</span>
            <span class="name-row">
              <input name="name" autocomplete="name" maxlength="40" aria-describedby="name-msg" />
              <button class="button" type="submit">Update</button>
            </span>
          </label>
          <p class="name-msg" id="name-msg" aria-live="polite" data-name-msg></p>
        </form>
        <button class="button primary" type="button" data-print><Icon name="print" />Print or save as PDF</button>
      </div>

      <article class="certificate" aria-label="Certificate">
        <div class="frame">
          <p class="c-school">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M12 6.5a4 4 0 0 1 8 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
              <rect x="5" y="6.5" width="22" height="22" rx="5" fill="currentColor" />
              <path d="M10.5 14h11M10.5 18.5h11M10.5 23h6.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
            </svg>
            {school.full}
          </p>
          <p class="c-kind">Certificate of completion</p>
          <p class="c-small">This certifies that</p>
          <p class="c-name" data-c-name>Your name</p>
          <p class="c-small">has completed the course</p>
          <p class="c-course">{c.title}</p>
          <p class="c-detail num" data-c-detail>
            {lessonsOf(c).length} lessons, {c.hours} hours
          </p>
          <div class="c-foot">
            <div>
              <p class="c-sign">{teacher.name}</p>
              <p class="c-line">Instructor</p>
            </div>
            <div>
              <p class="c-sign num" data-c-date></p>
              <p class="c-line">Date</p>
            </div>
            <div>
              <p class="c-sign num" data-c-id></p>
              <p class="c-line">Certificate number</p>
            </div>
          </div>
          <p class="c-demo">Example certificate from a demo site. Not a real qualification.</p>
        </div>
      </article>
    </section>
  </div>
</Base>

<script>
  import { courses } from '../../data/courses.js';
  import { certificateId, readStore, standing, writeStore, NAME_KEY } from '../../lib/learn.js';

  const page = document.querySelector<HTMLElement>('[data-cert-page]')!;
  const slug = page.dataset.slug!;
  const course = courses.find((x) => x.slug === slug)!;
  const locked = page.querySelector<HTMLElement>('[data-locked]')!;
  const ready = page.querySelector<HTMLElement>('[data-ready]')!;
  const form = page.querySelector<HTMLFormElement>('[data-name-form]')!;
  const input = form.elements.namedItem('name') as HTMLInputElement;
  const msg = form.querySelector<HTMLElement>('[data-name-msg]')!;

  function paintName(name: string) {
    page.querySelector('[data-c-name]')!.textContent = name || 'Your name';
    page.querySelector('[data-c-id]')!.textContent = certificateId(slug, name || 'learner');
  }

  function paint() {
    const s = standing(course);
    locked.hidden = s.certificate;
    ready.hidden = !s.certificate;
    if (!s.certificate) {
      const left = s.total - s.finished;
      const parts = [];
      if (left) parts.push(`finish ${left} more ${left === 1 ? 'lesson' : 'lessons'}`);
      if (!s.quiz?.passed) parts.push('pass the final quiz');
      locked.querySelector('[data-locked-text]')!.textContent = s.enrolled
        ? `To unlock it, ${parts.join(' and ')}.`
        : 'Join the course, finish every lesson and pass the final quiz to unlock it.';
      locked.querySelector<HTMLElement>('.bar')!.style.setProperty('--p', `${s.percent}%`);
      const go = locked.querySelector<HTMLAnchorElement>('[data-locked-go]')!;
      go.href = s.enrolled ? `/learn/${slug}/${s.next ? `#${s.next.id}` : '#quiz'}` : `/course/${slug}/`;
      return;
    }
    const name = String(readStore(NAME_KEY, '') || '');
    input.value = name;
    paintName(name);
    const at = s.quiz?.at ? new Date(s.quiz.at) : new Date();
    page.querySelector('[data-c-date]')!.textContent = at.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    page.querySelector('[data-c-detail]')!.textContent = `${s.total} lessons, ${course.hours} hours, final quiz ${s.quiz!.score} of ${s.quiz!.total}`;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = input.value.trim().replace(/\s+/g, ' ');
    if (name.length < 2) {
      msg.textContent = 'Write the name you want on the certificate.';
      msg.className = 'name-msg bad';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');
    writeStore(NAME_KEY, name);
    paintName(name);
    msg.textContent = 'Name updated on the certificate.';
    msg.className = 'name-msg good';
  });

  page.querySelector('[data-print]')!.addEventListener('click', () => window.print());
  paint();
</script>

<style>
  .cert-page {
    padding-top: var(--space-6);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
  }

  .back :global(.icon) {
    width: 18px;
  }

  .locked {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 560px;
    margin-top: var(--space-6);
  }

  .locked > :global(.icon) {
    width: 40px;
    color: var(--ink-3);
  }

  .locked h1 {
    font-size: var(--step-3);
  }

  .locked .bar {
    width: 100%;
  }

  .ready {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .ready-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .ready-head h1 {
    flex-basis: 100%;
    font-size: var(--step-3);
  }

  .name-form {
    flex: 1 1 22rem;
    max-width: 30rem;
  }

  .name-row {
    display: flex;
    gap: var(--space-2);
  }

  .name-row input {
    flex: 1;
    min-width: 0;
  }

  .name-msg {
    min-height: 1.4em;
    margin-top: var(--space-1);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .name-msg:empty {
    display: none;
  }

  .name-msg.good {
    color: var(--free);
  }

  .name-msg.bad {
    color: var(--error);
  }

  .certificate {
    container-type: inline-size;
    padding: clamp(10px, 2.2cqi, 22px);
    border-radius: var(--radius-s);
    background: #fbfaf6;
    box-shadow: var(--shadow-lift);
  }

  .frame {
    display: grid;
    justify-items: center;
    gap: clamp(4px, 1.1cqi, 12px);
    padding: clamp(20px, 5cqi, 56px) clamp(16px, 4cqi, 48px);
    border: clamp(3px, 0.6cqi, 6px) double #b9a46a;
    text-align: center;
  }

  .c-school {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: clamp(0.85rem, 1.8cqi, 1.15rem);
    color: var(--brand-deep);
  }

  .c-school svg {
    width: clamp(20px, 3.2cqi, 32px);
    color: var(--brand);
  }

  .c-kind {
    margin-top: clamp(4px, 1cqi, 10px);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.5rem, 4.6cqi, 3rem);
    line-height: 1.1;
  }

  .c-small {
    font-size: clamp(0.85rem, 1.7cqi, 1.05rem);
    color: var(--ink-2);
  }

  .c-name {
    max-width: 100%;
    padding-inline: var(--space-4);
    border-bottom: 1px solid #b9a46a;
    font-family: var(--font-head);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.75rem, 6cqi, 3.75rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .c-course {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.15rem, 3cqi, 1.9rem);
    line-height: 1.2;
  }

  .c-detail {
    font-size: clamp(0.85rem, 1.6cqi, 1rem);
    color: var(--ink-2);
  }

  .c-foot {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 3cqi, 40px);
    width: 100%;
    margin-top: clamp(12px, 3.5cqi, 40px);
  }

  .c-sign {
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--line-strong);
    font-weight: 700;
    font-size: clamp(0.8rem, 1.6cqi, 1.05rem);
    overflow-wrap: anywhere;
  }

  .c-line {
    margin-top: var(--space-1);
    font-size: clamp(0.72rem, 1.3cqi, 0.875rem);
    color: var(--ink-3);
  }

  .c-demo {
    margin-top: clamp(10px, 2.4cqi, 28px);
    font-size: clamp(0.72rem, 1.3cqi, 0.875rem);
    color: var(--ink-3);
  }

  @media (max-width: 520px) {
    .c-foot {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    :global(.demo-strip),
    :global(.site-header),
    :global(.site-footer),
    .back,
    .ready-head {
      display: none !important;
    }

    .certificate {
      box-shadow: none;
    }
  }
</style>
